<!doctype html>
<html lang="en">
  <head>
    <title>Reservation Confirm</title>
    <%- include("partials/header") %>
  </head>
  <body>
    <%- include("partials/navbar") %>

    <main class="container py-5">
      <div class="row justify-content-center">
        <div class="col-12 col-lg-6">
          <div class="card">
            <h1 class="card-header">Reservation confirmation</h1>
            <div class="card-body">
              <div class="mb-3">
                <div>Seat</div>
                <div class="fs-5 fw-bold"><%= q.zone %>-<%= q.number %></div>
              </div>

              <div class="mb-3">
                <div>Time</div>
                <div class="fs-5 fw-bold">
                  <%= q.date %> <%= q.startTime %> ~ <%= q.endTime %>
                </div>
              </div>

              <div class="mb-3">
                <label class="form-label">Name</label>
                <input
                  id="name"
                  class="form-control fw-bold"
                  placeholder="name"
                />
              </div>

              <div id="msg" class="text-danger small mb-3"></div>

              <div class="d-flex gap-2">
                <a class="btn btn-outline-secondary w-50" href="/reserve"
                  >Go back</a
                >
                <button id="confirmBtn" class="btn btn-primary w-50">
                  Reservation confirm
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </main>

    <%- include("partials/footer") %>
    <script>
      window.__RES_Q__ = <%- JSON.stringify(q) %>;
    </script>
    <script src="/js/reservation.js"></script>
  </body>
</html>
